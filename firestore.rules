rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Properties Collection: Public can read, only Admin can write
    match /properties/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Inquiries Collection: Public can create, only Admin can read/update/delete
    match /inquiries/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Seller Requests Collection: Public can create, only Admin can read/update/delete
    match /seller_requests/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
